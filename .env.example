DATABASE_URL=postgresql+psycopg2://teledesk@localhost:5432/teledesk
REDIS_URL=redis://localhost:6379/0
APP_ENV=development

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=teledesk

# from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# generate this key with:
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Active key version (mirrored on Channel.credentials_key_version). Bump on
# rotation and add the previous key to ENCRYPTION_KEYS below.
ENCRYPTION_KEY_VERSION=1
# Previous encryption keys for decrypting rotated credentials: {"1": "old-key", ...}
ENCRYPTION_KEYS={}
JWT_SECRET=change-me

# https URL only, no trailing slash
PUBLIC_BASE_URL=

# Cookie settings (set COOKIE_SECURE=true in production behind HTTPS)
SESSION_COOKIE_NAME=teledesk_session
REFRESH_COOKIE_NAME=teledesk_refresh
CSRF_COOKIE_NAME=teledesk_csrf
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ENABLE_BEARER_AUTH=false
CSRF_PROTECTION_ENABLED=true

# SMTP (console backend used in dev; SMTP required in production)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@teledesk.local
SMTP_USE_TLS=false

# Rate limiting
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900


